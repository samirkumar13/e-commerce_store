# PostgreSQL Database URL
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/circuithub"

# JWT Secret Key
JWT_SECRET="your-super-secret-key-change-this"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=5000

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID="your-merchant-id"
PHONEPE_SALT_KEY="your-salt-key"
PHONEPE_SALT_INDEX="1"
PHONEPE_API_URL="https://api-preprod.phonepe.com/apis/pg-sandbox"

# Shiprocket Credentials
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"

# URLs for redirects and callbacks
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# Environment ("production" tightens CORS and rate limits)
NODE_ENV="development"

# Logging level: trace | debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL="debug"

# Optional error tracking — leave blank to disable. Set to your Sentry DSN to enable.
SENTRY_DSN=""

# Database seeding via /api/seed/init is DISABLED by default.
# To run it once on a fresh DB, set ALLOW_SEED=true and pass the matching
# secret in an "x-seed-secret" request header. Unset both afterwards.
ALLOW_SEED="false"
SEED_SECRET="set-a-long-random-string-and-keep-it-private"
